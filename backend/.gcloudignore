# Used by "gcloud run deploy --source". Controls what is uploaded to Cloud Build.
# Unlike .dockerignore, this file must NOT exclude Dockerfile or .dockerignore:
# Cloud Build needs both to build the image.
.env
.env.*
*.json
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
files_upload/*
!files_upload/.gitkeep
test/
.gcloudignore

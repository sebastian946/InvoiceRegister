# Secrets
.env
.env.*
!.env.example
# Frontend defaults per mode hold URLs only, never secrets, so they are shared.
# Personal overrides and tokens go in frontend/.env.local, which stays ignored.
!frontend/.env.development
!frontend/.env.production
# Google service account keys
invoicesheets-*.json
*-service-account.json

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Frontend
node_modules/
# Built frontend copied next to the backend (only happens inside the image)
backend/static/

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Test and tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# User uploads. Test fixtures live in backend/test/fixtures/ and stay tracked.
backend/files_upload/*
!backend/files_upload/.gitkeep

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

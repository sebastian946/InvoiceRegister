# Used by "npm run build", which is what the deployment runs. Committed: no
# secrets here. VITE_* values are baked into the JavaScript sent to browsers.

# Base URL of the API as seen by the browser.
#
# Empty means "the same address this page was loaded from". That is the right
# value for our deployment, where one Cloud Run service serves both the page
# and the API: the app follows the service to whatever URL it has.
#
# Set a full URL only if the frontend is ever hosted somewhere else, e.g.
#   VITE_API_BASE=https://invoice-register-le2er7t7gq-uc.a.run.app
# That setup also needs CORS on the backend and a backend the browser may call.
VITE_API_BASE=

# Template for .env.local, your personal overrides for "npm run dev".
# Copy it:   Copy-Item .env.example .env.local
# .env.local is ignored by git, so a token placed there is never committed.

# Use the deployed backend instead of the local one.
BACKEND_URL=https://invoice-register-le2er7t7gq-uc.a.run.app

# The deployed backend is private. Get a token, valid for one hour, with:
#   gcloud auth print-identity-token
BACKEND_TOKEN=
